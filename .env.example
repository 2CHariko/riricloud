# Docker Compose 本地/生产配置模板
# 复制为 .env 后填写 JWT_SECRET、RIRICLOUD_ENCRYPTION_KEY、ADMIN_EMAIL、ADMIN_PASSWORD。
JWT_SECRET=
RIRICLOUD_ENCRYPTION_KEY=
RIRICLOUD_ENV=production
AUTO_SEED=false
MASTER_PORT=3000
MASTER_AGENT_ENABLED=true

# 可选：Master SQLite 数据目录与远程 Agent 运行数据目录；相对路径以 Compose 文件所在目录为基准。
# MASTER_DATA_PATH=./data
# AGENT_DATA_PATH=./data/agent

# 本机线路对外公布的主机名/IP；不填写时新库默认使用 127.0.0.1。
# 也可通过 RIRICLOUD_PUBLIC_URL 自动推导。
MASTER_LOCAL_HOST=
RIRICLOUD_PUBLIC_URL=

# 首次启动空数据库时创建首个管理员；已有管理员不会被环境变量覆盖。
ADMIN_EMAIL=
ADMIN_PASSWORD=

# 兼容旧配置，仅在对应 ADMIN_* 未填写时使用。
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# 可选：Master-Local 本机节点通信凭据与自定义镜像配置
# 不填写时 Master 自动生成强随机 Token；填入固定 Token 可使重新部署时凭证保持一致。
# MASTER_LOCAL_AGENT_TOKEN=
# AGENT_IMAGE=2chariko/riricloud-agent:latest
# MASTER_IMAGE=2chariko/riricloud-master:latest

# 可选：容器内进程运行身份 (默认 65532:65532 非 Root)。
# 若宿主机挂载目录权限受限（如以 root 部署且提示挂载目录无写入权限），可取消注释设为 0:0 以 root 运行。
# DOCKER_USER=0:0


