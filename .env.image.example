# RiriCloud 已导入镜像部署配置
# 使用 docker-compose.image.yml，并通过 --env-file .env.image 指定本文件。

# 默认推荐直接从 Docker Hub 官方源在线拉取（支持 latest 或固定具体版本号）。
# 若从 GHCR 在线拉取，可配置为 ghcr.io/2chariko/riricloud-master:latest 与 ghcr.io/2chariko/riricloud-agent:latest
# 若使用本地离线导出包导入，可配置为 riricloud/master:0.9.5 与 riricloud/agent:0.8.5
MASTER_IMAGE=2chariko/riricloud-master:latest
AGENT_IMAGE=2chariko/riricloud-agent:latest

MASTER_PORT=3000
MASTER_AGENT_ENABLED=true
MASTER_LOCAL_HOST=

# 可选：Master SQLite 数据目录与远程 Agent 运行数据目录；相对路径以 Compose 文件所在目录为基准。
# MASTER_DATA_PATH=./data
# AGENT_DATA_PATH=./data/agent

JWT_SECRET=
# 必须长期保持不变；已有数据库必须继续使用原密钥，否则历史密文无法解密。
RIRICLOUD_ENCRYPTION_KEY=
AUTO_SEED=false

# 首次启动空数据库时创建首个管理员，密码长度必须为 8-64 位，并且必须同时包含大写字母、小写字母、数字和特殊字符。
ADMIN_EMAIL=
ADMIN_PASSWORD=

# 兼容旧配置，仅在对应 ADMIN_* 未填写时使用。
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# 可选：Master-Local 本机节点通信凭据；不填写时 Master 自动生成强随机 Token。
# MASTER_LOCAL_AGENT_TOKEN=
# RIRICLOUD_PUBLIC_URL=https://master.example.com

# 可选：容器内进程运行身份 (默认 65532:65532 非 Root)。
# 若宿主机挂载目录权限受限（如以 root 部署且提示挂载目录无写入权限），可取消注释设为 0:0 以 root 运行。
# DOCKER_USER=0:0

