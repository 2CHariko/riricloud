// RiriCloud 数据模型（设计见 docs/DATA_MODELS.md）
// SQLite 不支持 Prisma enum，角色/状态/协议均落地为 String + 应用层 class-validator 校验

generator client {
  provider      = "prisma-client-js"
  // native=发布/开发机（Windows），debian-openssl-3.0.x=主控端发行包目标机（Linux x64）
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                String    @id @default(uuid())
  uid               Int?      @unique // 6 位随机数字用户标识
  nickname          String? // 用户自定义昵称；为空时由应用层回退为 用户_<UID>
  email             String    @unique
  emailVerifiedAt   DateTime? // 邮箱核验时间；未核验或存量老用户为 null
  passwordHash      String
  role              String    @default("USER") // Role 枚举：ADMIN | USER
  balance           Int       @default(0) // 账户余额，单位为分
  deviceLimit       Int? // null 跟随套餐，0 不限制，正数为用户覆盖
  trafficLimitBytes BigInt    @default(107374182400) // 100 GiB
  trafficUsedBytes  BigInt    @default(0)
  expireAt          DateTime?
  subscriptionToken String    @unique @default(uuid())
  uuid              String    @unique @default(uuid()) // VLESS/Sing-box 用户识别
  password          String? // SS/Hysteria2 连接密码（预留）
  isActive          Boolean   @default(true)
  sessionVersion    Int       @default(0)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  trafficLogs            TrafficLog[]
  subscription           Subscription?
  planPurchaseIdentityId String?
  planPurchaseIdentity   PlanPurchaseIdentity? @relation(fields: [planPurchaseIdentityId], references: [id], onDelete: SetNull)
  balanceTransactions    BalanceTransaction[]
  redeemedCodes          RedeemCode[]          @relation("RedeemedCodes")
  extraLineGrants        UserLineGrant[]
  proxyKeys              ProxyKey[]

  @@index([role])
  @@index([isActive])
  @@index([planPurchaseIdentityId])
}

// 套餐购买身份与可删除账号解耦；邮箱哈希别名确保同邮箱重建账号仍继承限购记录。
model PlanPurchaseIdentity {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users        User[]
  emailAliases PlanPurchaseEmailAlias[]
  purchases    PlanPurchase[]
  redeemCodeUsages RedeemCodeCategoryUsage[]
}

model PlanPurchaseEmailAlias {
  id         String   @id @default(uuid())
  identityId String
  emailHash  String   @unique
  createdAt  DateTime @default(now())

  identity PlanPurchaseIdentity @relation(fields: [identityId], references: [id], onDelete: Cascade)

  @@index([identityId])
}

model PlanPurchase {
  id             String   @id @default(uuid())
  identityId     String
  planId         String
  sequence       Int
  source         String // SELF_BUY | SELF_UPGRADE | REGISTRATION | ADMIN | MIGRATED | REDEEM_CODE
  subscriptionId String?
  purchasedAt    DateTime @default(now())

  identity     PlanPurchaseIdentity @relation(fields: [identityId], references: [id], onDelete: Restrict)
  plan         Plan                 @relation(fields: [planId], references: [id], onDelete: Restrict)
  subscription Subscription?        @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  @@unique([identityId, planId, sequence])
  @@index([identityId, planId])
  @@index([planId])
}

// ==============================
// 2.4 直连代理池凭据 (ProxyKey，v0.9.0)
// 面向自动化环境（爬虫 / 指纹浏览器 / 脚本工具）的独立 SOCKS5/HTTP 凭证，
// 与面向客户端翻墙的订阅体系完全解耦，共享主账户流量配额。
// ==============================
model ProxyKey {
  id               String    @id @default(uuid())
  userId           String
  name             String
  username         String    @unique // pk_<高熵> 用户名，注入 Sing-box mixed 入站
  password         String // 该凭据独立密码（明文，Sing-box 入站校验必需）
  whitelistIps     String    @default("") // 逗号分隔的 IP/CIDR 白名单，空串表示不限制来源
  exportToken      String    @unique @default(uuid()) // 免登录动态拉取令牌
  isActive         Boolean   @default(true)
  trafficUsedBytes BigInt    @default(0) // 该凭据累计计费流量（与主账户口径一致）
  lastUsedAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  trafficLogs TrafficLog[] @relation("ProxyKeyTrafficLogs")

  @@index([userId])
  @@index([isActive])
  @@index([userId, isActive])
}

model VerificationCode {
  id        String   @id @default(uuid())
  email     String
  codeHash  String
  action    String // REGISTER | CHANGE_EMAIL | VERIFY_CURRENT_EMAIL | RESET_PASSWORD
  attempts  Int      @default(0)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email, action, createdAt])
  @@index([expiresAt])
}

model CaptchaChallenge {
  id         String    @id @default(uuid())
  tokenHash  String    @unique
  answerHash String
  ipHash     String?
  attempts   Int       @default(0)
  consumedAt DateTime?
  expiresAt  DateTime
  createdAt  DateTime  @default(now())

  @@index([expiresAt])
}

model Node {
  id                    String    @id @default(uuid())
  name                  String
  serverHost            String
  reachability          String    @default("PUBLIC") // PUBLIC | NAT (无公网 IP/家宽节点，通过反向隧道作为落地中继)
  isLocal               Boolean   @default(false) // 主控本机预置节点
  configOverride        String? // 高级模式：完整 singboxConfig 顶层覆盖 JSON（与生成配置深合并）
  singboxLogMode        String    @default("NORMAL") // NORMAL | INFO | DEBUG（临时诊断日志模式）
  singboxLogModeUntil   DateTime? // 诊断模式自动过期时间
  agentToken            String    @unique
  agentTokenHash        String?   @unique
  communicationMode     String    @default("WS") // WS | HTTP
  pollIntervalSecs      Int       @default(15) // HTTP 轮询建议周期，秒
  status                String    @default("OFFLINE") // ONLINE | OFFLINE | DISABLED
  lastSeenAt            DateTime?
  cpuUsage              Float?
  memoryUsage           Float?
  bandwidthRate         Float?
  uploadRate            Float?
  downloadRate          Float?
  kernelRunning         Boolean? // Agent 心跳上报的内核进程存活状态（旧版 Agent 不上报时保持 null）
  configError           String? // 最近一次配置应用失败原因（check 失败/回执失败），成功后清空
  lastProbeResult       String? // 最近一次网络探针结果 JSON
  agentVersion          String? // Agent 编译版本
  agentProtocolVersion  Int? // Agent 上报的 Master-Agent 协议版本
  osArch                String? // Agent 运行平台与架构，例如 linux/amd64
  kernelVersion         String? // sing-box 内核版本
  capabilitiesJson      String    @default("[]")
  currentAgentAssetId   String?
  currentSingboxAssetId String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  // NodeInbound 为历史迁移兼容表，新线路配置不再依赖它。
  inbounds              NodeInbound[]
  entryLines            Line[]                 @relation("LineEntryNode")
  landingLines          Line[]                 @relation("LineLandingNode")
  trafficLogs           TrafficLog[]
  trafficCursors        TrafficCursor[]
  binaryDeploymentTasks BinaryDeploymentTask[]
  mirrorSites           MirrorSite[]

  @@index([status])
  @@index([isLocal])
}

model MirrorSite {
  id                 String    @id @default(uuid())
  name               String
  slug               String    @unique
  enabled            Boolean   @default(false)
  upstreamBaseUrl    String
  allowedOriginsJson String    @default("[]")
  nodeId             String
  accessMode         String    @default("ADMIN")
  shareTokenHash     String?   @unique
  shareExpiresAt     DateTime?
  shareRotatedAt     DateTime?
  lastRequestAt      DateTime?
  lastStatusCode     Int?
  lastErrorCode      String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  node Node @relation(fields: [nodeId], references: [id], onDelete: Cascade)

  @@index([nodeId])
  @@index([enabled, createdAt])
  @@index([accessMode, enabled])
}

// Sing-box 累计流量游标：按节点与原始用户凭证保存上次已观察的总量。
model TrafficCursor {
  id            String   @id @default(uuid())
  nodeId        String
  credential    String
  uploadTotal   BigInt   @default(0)
  downloadTotal BigInt   @default(0)
  updatedAt     DateTime @updatedAt

  node Node @relation(fields: [nodeId], references: [id], onDelete: Cascade)

  @@unique([nodeId, credential])
  @@index([nodeId, updatedAt])
}

model Plan {
  id                   String   @id @default(uuid())
  name                 String
  description          String?
  price                Int      @default(0) // 价格最小货币单位
  durationDays         Int
  trafficLimitBytes    BigInt
  trafficResetMode     String   @default("NONE") // NONE | CALENDAR_MONTH | SUBSCRIPTION_CYCLE
  lineMatchMode        String   @default("ALL") // ALL | TAGS | EXPLICIT
  lineTagsJson         String   @default("[]")
  lineIdsJson          String   @default("[]")
  templateId           String?
  badgeText            String?
  isFeatured           Boolean  @default(false)
  featuresJson         String   @default("[]")
  cardConfigJson       String   @default("{}")
  isPublic             Boolean  @default(true)
  sortOrder            Int      @default(0)
  purchaseLimitPerUser Int? // null 表示不限购；>=1 时限制每购买身份累计次数
  allowRenewal         Boolean  @default(true)
  speedLimitMbps       Int?     @default(0) // 用户套餐带宽速率上限 (Mbps), 0 或 null 为不限制
  deviceLimit          Int?     @default(0) // 同时在线设备上限，0 或 null 为不限制
  appendSpeedBadge     String   @default("INHERIT") // INHERIT | ENABLE | DISABLE (订阅节点追加速率角标)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  template      SubscriptionTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  subscriptions Subscription[]
  purchases     PlanPurchase[]
  redeemCodeCategories RedeemCodeCategory[]

  @@index([isPublic])
  @@index([sortOrder])
}

// ==============================
// 2.3 接入线路实体 (Line，v0.4.0)
// Line 是唯一面向用户的代理业务端点，内聚协议、参数与入口/出口拓扑。
// ==============================
model Line {
  id                      String    @id @default(uuid())
  name                    String
  tag                     String?
  listen                  String    @default("0.0.0.0")
  type                    String    @default("DIRECT") // DIRECT | RELAY | EXTERNAL
  relayMode               String? // BLIND_FORWARD | PROTOCOL_PROXY | TARGET_LINE | UPSTREAM_NODE
  protocolType            String    @default("VLESS") // ProtocolType
  paramsJson              String    @default("{}") // 协议专属参数 JSON
  entryNodeId             String?
  entryPort               Int?
  landingNodeId           String?
  landingPort             Int?
  targetLineId            String?
  certificateId           String?
  endpointOverrideEnabled Boolean   @default(false)
  serverHost              String?
  serverPort              Int?
  serverName              String?
  host                    String?
  landingEndpointOverrideEnabled Boolean   @default(false)
  landingServerHost       String?
  landingServerPort       Int?
  trafficRate             Float     @default(1)
  allowLanAccess          Boolean   @default(false) // 落地端是否允许访问局域网私网 IP (默认 false 拦截)
  tunnelType              String? // TCP_MUX | WIREGUARD (反向穿透隧道类型，NAT 落地中继时生效)
  tunnelPort              Int? // 入口 VPS 监听的隧道连接端口
  tunnelSecret            String? // AES-GCM 加密存储的隧道握手鉴权凭据
  speedLimitMbps          Int?      @default(0) // 物理端口带宽限速 (Mbps), 0 或 null 为不限制
  tcpFastOpen             Boolean   @default(false) // 开启 TCP Fast Open
  tcpMultiPath            Boolean   @default(false) // 开启 MPTCP
  udpFragment             Boolean? // UDP 分片
  udpTimeout              String? // UDP 超时时长（如 "5m", "300s"）
  proxyProtocol           Boolean   @default(false) // 开启 PROXY Protocol 解析 (自动兼容 v1 与 v2)
  proxyProtocolAcceptNoHeader Boolean @default(false) // 是否接受无 PROXY 头的连接
  tagsJson                String    @default("[]")
  level                   Int       @default(0)
  sortOrder               Int       @default(0)
  isPublic                Boolean   @default(true)
  proxyPoolEnabled        Boolean   @default(false) // 是否显式接入标准代理池，仅支持 MIXED 直连/上游中继
  status                  String    @default("ACTIVE") // ACTIVE | DISABLED
  lastLatencyMs           Int? // 最近测速延迟（毫秒），null 为未测速或失败
  lastTestedAt            DateTime? // 最近一次测速时间
  lastTestStatus          String? // 最近测速状态：SUCCESS | TIMEOUT | ERROR
  lastTestMessage         String? // 最近测速诊断详情
  lastProbeJson           String? // schemaVersion=1 的安全端到端拨测摘要，不含连接秘密
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  entryNode       Node?           @relation("LineEntryNode", fields: [entryNodeId], references: [id], onDelete: Cascade)
  landingNode     Node?           @relation("LineLandingNode", fields: [landingNodeId], references: [id], onDelete: Cascade)
  targetLine      Line?           @relation("LineRelayTarget", fields: [targetLineId], references: [id], onDelete: Restrict)
  relaySources    Line[]          @relation("LineRelayTarget")
  certificate     Certificate?    @relation(fields: [certificateId], references: [id], onDelete: SetNull)
  trafficLogs     TrafficLog[]
  extraLineGrants UserLineGrant[]
  upstreamNodeId  String?
  upstreamNode    UpstreamNode?   @relation("LineUpstreamNode", fields: [upstreamNodeId], references: [id], onDelete: SetNull)

  @@index([entryNodeId])
  @@index([landingNodeId])
  @@index([targetLineId])
  @@index([certificateId])
  @@index([protocolType])
  @@index([type, status])
  @@index([isPublic])
  @@index([sortOrder])
  @@index([upstreamNodeId])
}

model Certificate {
  id             String   @id @default(uuid())
  name           String
  certificatePem String
  privateKeyPem  String
  subject        String
  issuer         String
  serialNumber   String
  sansJson       String   @default("[]")
  validFrom      DateTime
  validTo        DateTime
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  lines Line[]

  @@index([validTo])
}

model SubscriptionTemplate {
  id               String   @id @default(uuid())
  name             String
  description      String?
  isDefault        Boolean  @default(false)
  isBuiltin        Boolean  @default(false)
  proxyGroupsJson  String   @default("[]")
  ruleSetsJson     String   @default("[]")
  dnsConfigJson    String   @default("{}")
  customInjectYaml String?
  customInjectJson String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  plans Plan[]

  @@index([isDefault])
}

model Subscription {
  id                   String    @id @default(uuid())
  userId               String    @unique
  planId               String
  status               String    @default("ACTIVE") // ACTIVE | CANCELED | EXPIRED | REVOKED
  trafficLimitBytes    BigInt
  trafficUsedBytes     BigInt    @default(0)
  startedAt            DateTime  @default(now())
  expireAt             DateTime?
  subscriptionToken    String    @unique @default(uuid())
  canceledAt           DateTime?
  trafficPeriodStartAt DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan          Plan           @relation(fields: [planId], references: [id])
  planPurchases PlanPurchase[]
  planSnapshotJson String? // immutable benefits for a redeemed plan code

  @@index([status])
  @@index([expireAt])
  @@index([trafficPeriodStartAt])
}

// 用户级额外线路授权，独立于订阅生命周期长期保留。
model UserLineGrant {
  id        String   @id @default(uuid())
  userId    String
  lineId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  line Line @relation(fields: [lineId], references: [id], onDelete: Cascade)

  @@unique([userId, lineId])
  @@index([userId])
  @@index([lineId])
}

// 钱包余额流水，amount 为带符号的最小货币单位（分）。
model BalanceTransaction {
  id            String   @id @default(uuid())
  userId        String
  amount        Int
  balanceBefore Int
  balanceAfter  Int
  type          String
  description   String?
  referenceId   String?
  redeemCodeId  String?  @unique
  createdAt     DateTime @default(now())

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  redeemCode RedeemCode? @relation(fields: [redeemCodeId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([type, createdAt])
  @@index([referenceId])
}

// 卡密分类同时定义奖励与按购买身份的累计兑换上限；null 上限表示不限。
model RedeemCodeCategory {
  id                     String   @id @default(uuid())
  name                   String   @unique
  tagsJson               String   @default("[]")
  rewardType             String   @default("BALANCE") // BALANCE | PLAN
  rewardAmount           Int?
  planId                 String?
  limitPerIdentity       Int?     @default(1)
  isActive               Boolean  @default(true)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  redeemCodes RedeemCode[]
  usages      RedeemCodeCategoryUsage[]
  plan        Plan?    @relation(fields: [planId], references: [id], onDelete: SetNull)

  @@index([isActive])
}

model RedeemCodeCategoryUsage {
  identityId String
  categoryId String
  usedCount  Int      @default(0)
  updatedAt  DateTime @updatedAt

  identity PlanPurchaseIdentity @relation(fields: [identityId], references: [id], onDelete: Restrict)
  category RedeemCodeCategory  @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@id([identityId, categoryId])
  @@index([categoryId])
}

// 管理员生成的卡密；code 始终以大写形式落库。删除只隐藏，不能影响卡密履约。
model RedeemCode {
  id               String    @id @default(uuid())
  code             String    @unique
  amount           Int       @default(0)
  categoryId       String?
  rewardType       String    @default("BALANCE")
  rewardSnapshotJson String?
  planId           String?
  status           String    @default("UNUSED") // UNUSED | REDEEMED | REVOKED
  expiresAt        DateTime?
  note             String?
  redeemedAt       DateTime?
  redeemedByUserId String?
  deletedAt        DateTime?
  deletedByUserId  String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  redeemedBy         User?               @relation("RedeemedCodes", fields: [redeemedByUserId], references: [id], onDelete: SetNull)
  category           RedeemCodeCategory? @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  balanceTransaction BalanceTransaction?

  @@index([status, createdAt])
  @@index([expiresAt])
  @@index([categoryId, status])
  @@index([deletedAt])
  @@index([planId, status])
  @@index([redeemedByUserId])
}

model NodeInbound {
  id         String   @id @default(uuid())
  nodeId     String
  type       String // ProtocolType 枚举：VLESS_REALITY | HYSTERIA2 | SHADOWSOCKS | TUIC
  tag        String // sing-box 入站 tag，节点内唯一
  listen     String   @default("0.0.0.0")
  port       Int
  paramsJson String   @default("{}") // 协议专属参数 JSON（结构见 docs/DATA_MODELS.md §3.1）
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  node Node @relation(fields: [nodeId], references: [id], onDelete: Cascade)

  @@unique([nodeId, tag])
  @@index([nodeId])
}

model TrafficLog {
  id         String   @id @default(uuid())
  nodeId     String
  userId     String
  lineId     String?
  proxyKeyId String? // 直连代理池凭据归属（订阅流量为 null）
  upload     BigInt   @default(0) // 增量字节
  download   BigInt   @default(0)
  recordedAt DateTime @default(now())

  node     Node      @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  line     Line?     @relation(fields: [lineId], references: [id], onDelete: SetNull)
  proxyKey ProxyKey? @relation("ProxyKeyTrafficLogs", fields: [proxyKeyId], references: [id], onDelete: SetNull)

  @@index([nodeId])
  @@index([userId])
  @@index([lineId])
  @@index([proxyKeyId])
  @@index([recordedAt])
  @@index([recordedAt, lineId])
  @@index([recordedAt, userId])
}

model SystemSetting {
  key         String   @id
  value       String // 站点名/默认配额/注册开关等 JSON 或文本
  description String?
  updatedAt   DateTime @updatedAt
}

// ==============================
// 4. 二进制资源中心
// BinaryRelease 是逻辑资源版本，BinaryAsset 是具体平台资产。
// ==============================
model BinaryRelease {
  id                  String   @id @default(uuid())
  kind                String   @default("AGENT") // AGENT
  upstreamVersion     String
  revision            Int      @default(1)
  source              String   @default("UPLOAD") // LOCAL | UPLOAD | REMOTE | GITHUB
  status              String   @default("ACTIVE") // DRAFT | ACTIVE | DISABLED | RETIRED
  builtFromAppVersion String?
  compatibilityJson   String   @default("{}")
  notes               String?
  isDefault           Boolean  @default(false)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  assets          BinaryAsset[]
  deploymentTasks BinaryDeploymentTask[]

  @@unique([kind, upstreamVersion, revision])
  @@index([kind, status])
  @@index([isDefault])
}

model BinaryAsset {
  id          String   @id @default(uuid())
  releaseId   String
  target      String // agent-linux-amd64, agent-windows-amd64 等
  os          String
  arch        String
  filename    String
  storageRoot String   @default("RUNTIME")
  storagePath String
  sha256      String
  size        Int
  available   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  release             BinaryRelease          @relation(fields: [releaseId], references: [id], onDelete: Cascade)
  files               BinaryAssetFile[]
  deploymentTasks     BinaryDeploymentTask[] @relation("TargetBinaryAsset")
  previousDeployments BinaryDeploymentTask[] @relation("PreviousBinaryAsset")

  @@unique([releaseId, target])
  @@index([target, available])
}

model BinaryAssetFile {
  id          String   @id @default(uuid())
  assetId     String
  name        String
  role        String   @default("main") // main | auxiliary
  storageRoot String   @default("RUNTIME")
  storagePath String
  sha256      String
  size        Int
  mode        Int      @default(493) // 0755
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  asset BinaryAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@unique([assetId, name])
  @@index([sha256])
}

model BinaryDeploymentTask {
  id              String    @id @default(uuid())
  nodeId          String
  assetId         String? // 自定义 URL 升级或原资产已删除时为空
  previousAssetId String?
  releaseId       String? // 自定义 URL 升级或原资源已删除时为空
  kind            String    @default("AGENT")
  operation       String    @default("UPGRADE") // UPGRADE | ROLLBACK
  status          String    @default("QUEUED") // QUEUED | DISPATCHED | COMPLETED | FAILED
  attempts        Int       @default(0)
  payloadJson     String    @default("{}")
  errorMessage    String?
  requestedById   String?
  requestedAt     DateTime  @default(now())
  dispatchedAt    DateTime?
  completedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  node          Node           @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  asset         BinaryAsset?   @relation("TargetBinaryAsset", fields: [assetId], references: [id], onDelete: SetNull)
  previousAsset BinaryAsset?   @relation("PreviousBinaryAsset", fields: [previousAssetId], references: [id], onDelete: SetNull)
  release       BinaryRelease? @relation(fields: [releaseId], references: [id], onDelete: SetNull)

  @@index([nodeId, status])
  @@index([assetId])
  @@index([releaseId])
  @@index([requestedAt])
}


// ==============================
// 5. 帮助中心与使用文档 (HelpArticle)
// 面向 0 基础用户的使用教程与排错指南，支持平台分类、多语言、排序与 Markdown 渲染
// ==============================
model HelpArticle {
  id          String   @id @default(uuid())
  slug        String   @unique
  title       String
  platform    String   @default("ALL") // WINDOWS | MACOS | IOS | ANDROID | ROUTER | FAQ | GENERAL
  clientName  String?  // 客户端名称，如 "Clash Verge Rev", "Shadowrocket"
  icon        String?  // 图标标示
  summary     String?  // 简短摘要
  content     String   // Markdown 正文，支持动态变量插值
  sortOrder   Int      @default(0)
  isPublished Boolean  @default(true)
  locale      String   @default("zh-CN")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([platform, isPublished, sortOrder])
  @@index([locale, isPublished])
  @@index([sortOrder])
}

// ==============================
// 6. 上游订阅与代理节点 (UpstreamSubscription / UpstreamNode)
// ==============================
model UpstreamSubscription {
  id                 String         @id @default(uuid())
  name               String
  sourceType         String         @default("URL") // URL | TEXT
  format             String         @default("AUTO") // AUTO | CLASH_META | SINGBOX | URI_LIST
  detectedFormat     String?
  url                String?
  content            String?        // 文本快照或最近一次成功拉取的内容
  customHeadersJson  String         @default("{}") // 自定义 HTTP 请求头 (如 User-Agent)
  autoUpdate         Boolean        @default(true) // 是否开启定时自动刷新
  updateIntervalMins Int            @default(720)  // 自动刷新周期 (分钟，默认 12 小时)
  lastSyncAt         DateTime?
  lastSuccessAt      DateTime?
  lastSyncStatus     String         @default("PENDING") // PENDING | SUCCESS | FAILED
  lastSyncMessage    String?
  userInfoUsedBytes  BigInt?        // 从 subscription-userinfo 响应头解析出的已用流量
  userInfoTotalBytes BigInt?        // 从 subscription-userinfo 响应头解析出的总配额
  userInfoExpireAt   DateTime?      // 从 subscription-userinfo 响应头解析出的过期时间
  nodeCount          Int            @default(0)
  status             String         @default("ACTIVE") // ACTIVE | DISABLED
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  nodes UpstreamNode[]

  @@index([status])
  @@index([autoUpdate, lastSyncAt])
}

model UpstreamNode {
  id              String               @id @default(uuid())
  subscriptionId  String
  name            String
  protocolType    String               // VLESS, VMESS, TROJAN, HYSTERIA2, TUIC, SHADOWSOCKS, SOCKS, HTTP, etc.
  serverHost      String
  serverPort      Int
  paramsJson      String               // 归一化 Sing-box outbound 核心参数 (JSON)
  rawConfigJson   String               // 原始节点结构快照
  sourceKey       String?
  connectionHash  String               // 完整连接特征，不作为业务 UUID
  configHash      String               // 归一化配置变化哈希
  presenceStatus  String               @default("PRESENT") // PRESENT | MISSING
  missingSince    DateTime?
  tagsJson        String               @default("[]") // 自动解析标签 (HK, JP, US, IEPL 等)
  latencyMs       Int?
  lastTestedAt    DateTime?
  lastTestStatus  String?              // SUCCESS | TIMEOUT | ERROR
  lastTestMessage String?
  lastProbeJson   String?              // 实际内核/路径/目标/配置版本与结果摘要
  status          String               @default("ACTIVE") // ACTIVE | DISABLED
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  subscription UpstreamSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  relayLines   Line[]               @relation("LineUpstreamNode")

  @@index([subscriptionId])
  @@index([protocolType])
  @@index([status, presenceStatus])
  @@index([subscriptionId, sourceKey])
  @@index([subscriptionId, connectionHash])
}
