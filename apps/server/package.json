{
  "name": "@riricloud/server",
  "private": true,
  "description": "RiriCloud 主控后端（NestJS + Prisma + SQLite）",
  "files": [
    "dist",
    "prisma"
  ],
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node prisma/maintenance-start.js",
    "lint": "eslint .",
    "test": "jest",
    "postinstall": "prisma generate && prisma generate --schema=prisma/telemetry/schema.prisma",
    "prisma:generate": "prisma generate && prisma generate --schema=prisma/telemetry/schema.prisma",
    "prisma:migrate": "prisma migrate dev",
    "prisma:telemetry:migrate": "prisma migrate dev --schema=prisma/telemetry/schema.prisma",
    "prisma:telemetry:deploy": "prisma migrate deploy --schema=prisma/telemetry/schema.prisma",
    "prisma:deploy": "node prisma/deploy-databases.js",
    "prisma:seed": "prisma db seed",
    "backup:create": "node prisma/maintenance-cli.js backup:create",
    "backup:verify": "node prisma/maintenance-cli.js backup:verify",
    "backup:restore": "node prisma/maintenance-cli.js backup:restore",
    "test:maintenance": "node --test prisma/maintenance-backup.test.js prisma/maintenance-entrypoints.test.js"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/passport": "^11.0.0",
    "@nestjs/platform-express": "^11.1.0",
    "@nestjs/platform-ws": "^11.1.0",
    "@nestjs/swagger": "^11.2.0",
    "@nestjs/websockets": "^11.1.0",
    "@prisma/client": "^6.16.0",
    "adm-zip": "^0.6.1",
    "archiver": "^7.0.1",
    "bcryptjs": "^3.0.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "nodemailer": "^10.0.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "prisma": "^6.19.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "svg-captcha": "^1.4.0",
    "ws": "^8.18.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.1.0",
    "@types/adm-zip": "^0.5.8",
    "@types/archiver": "^6.0.3",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^8.0.1",
    "@types/passport-jwt": "^4.0.1",
    "@types/ws": "^8.5.13",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
